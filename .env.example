# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=libsysdb
POSTGRES_USER=libsys
POSTGRES_PASSWORD=changeme

# ─── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# ─── API ──────────────────────────────────────────────────────────────────────
# Internal port the FastAPI/Gunicorn process listens on inside the container.
API_PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://libsys:changeme@db:5432/libsysdb
