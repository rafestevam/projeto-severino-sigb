# Copie para .env.local (ou .env.production) e ajuste.

# ─── Autenticação ─────────────────────────────────────────────────────────────
# true = ignora o Keycloak e usa um token fictício de admin (apenas dev).
VITE_DEV_AUTH=false
# true = com VITE_DEV_AUTH, começa como visitante anônimo (testar o OPAC).
VITE_DEV_AUTH_ANON=false

# ─── Keycloak ─────────────────────────────────────────────────────────────────
VITE_KC_URL=https://localhost:8443/auth
VITE_KC_REALM=libsys
VITE_KC_CLIENT=libsys-spa
