# Modo de desenvolvimento sem Keycloak.
# Quando VITE_DEV_AUTH=true, o auth store usa um stub local em vez do Keycloak.
VITE_DEV_AUTH=true

# Com VITE_DEV_AUTH_ANON=true a SPA começa como visitante anônimo (para
# desenvolver o OPAC); "Entrar" ativa a sessão fictícia de admin.
VITE_DEV_AUTH_ANON=false
